# WhyMath — 줄바꿈·바이너리 정책
#
# 목적:
#   Windows 클라이언트(git for Windows)의 core.autocrlf=true 기본값으로 인해
#   .sh / .bash 등이 CRLF 로 체크아웃되어 WSL bash 실행이 거부되는 사고를 방지.
#
# 동작:
#   - text eol=lf  → 저장소·체크아웃 모두 LF 로 고정 (OS 무관)
#   - binary       → diff/merge 대상 제외, 변환 없음
#
# 적용 시점:
#   .gitattributes 추가 직후, 이미 working tree 에 있는 파일은 자동 정규화되지
#   않는다. 필요 시 'git add --renormalize .' 후 커밋, 또는 'git checkout -- <path>'
#   로 재체크아웃.

# 셸 스크립트 — WSL/Linux 실행 환경 호환
*.sh        text eol=lf
*.bash      text eol=lf

# PowerShell — Windows 실행 환경. CRLF 고정(Windows 관례) + UTF-8 BOM은 파일 내용이라 보존된다.
#   (BOM 없으면 Windows PowerShell 5.1이 .ps1을 시스템 코드페이지로 읽어 비ASCII(한글)가 깨져
#    파서 오류. BOM은 이 변환과 무관하게 유지됨.)
*.ps1       text eol=crlf

# Python — Linux/macOS 빌드 호환 (Windows 에서도 LF 동작)
*.py        text eol=lf
*.pyi       text eol=lf

# YAML/TOML/INI — LF 권장 (대부분의 파서는 무관하지만 통일)
*.yml       text eol=lf
*.yaml      text eol=lf
*.toml      text eol=lf
*.ini       text eol=lf

# Markdown/JSON — Git 디폴트(text auto) 유지: 강제 LF 없이 자동 처리
*.md        text
*.json      text

# 병렬 세션 — append-only 로그는 union merge (양쪽 줄 모두 보존, conflict 회피)
#   여러 Claude Code 세션이 동시에 결정 로그를 끝에 append해도 git 이 자동 병합.
#   주의: 같은 항목을 양쪽이 수정하면 중복 라인이 남을 수 있으므로 "새 항목은 파일 끝에
#   append" 관행을 지킬 것 (docs/standards/parallel_sessions.md 참조).
MEMORY.md   merge=union
backlog/events.ndjson   merge=union
# HARN-46: 이벤트 대장은 세션(=브랜치)당 1샤드(backlog/events/<actor>.ndjson)로 분리 —
# 서로 다른 세션은 서로 다른 파일에 쓰므로 충돌 자체가 없다. 아래 union은 같은 actor
# 이름이 재생성 브랜치·이름 붕괴 쌍에서 겹치는 잔여 경우의 로컬 방어일 뿐이며,
# GitHub 서버는 merge driver를 적용하지 않는다는 사실(사고 원인)은 변하지 않는다.
backlog/events/*.ndjson   merge=union

# 라이선스 약관 스냅샷 — **바이트 그대로가 증거다** (변환 금지)
#
#   이 파일들은 외부 사이트가 그 시점에 서빙한 약관 원문이며 meta.json의 sha256이
#   그것을 증명한다. Git 기본 `text auto`는 .html을 텍스트로 판단해 CRLF를 LF로
#   정규화하는데, 그러면 바이트가 바뀌어 **해시 검증이 깨진다**.
#
#   실측(2026-09-14): 스냅샷 20건 중 5건의 sha256이 기록과 어긋나 있었다. ncic는
#   차이 1,975바이트 = LF 1,975개, schoolinfo는 19바이트 = LF 19개로 정확히
#   일치해 원인이 CRLF 정규화임이 확정됐다(CRLF 복원 시 기록 해시와 바이트 동일).
#   나머지 3건은 원본이 혼합 줄바꿈이라 어느 줄이 CRLF였는지 알 수 없어 복원 불가다.
#
#   `-text`는 어떤 방향으로도 변환하지 않는다는 뜻이다. 인코딩(euc-kr 등)도 그대로
#   보존되며, 그 정당성은 meta의 charset 선언과 대조해 `scripts/ops/cp949_guard.py`가
#   판정한다.
data/licenses/snapshots/**   -text

# 바이너리 — 변환·diff 금지
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.pdf       binary
*.zip       binary
*.zst       binary
*.tar       binary
*.gz        binary
*.bin       binary
*.gguf      binary
*.safetensors binary
