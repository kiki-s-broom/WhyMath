{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(uv:*)",
      "Bash(pytest:*)",
      "Bash(ruff:*)",
      "Bash(black:*)",
      "Bash(mypy:*)",
      "Bash(flutter:*)",
      "Bash(dart:*)",
      "Bash(python3 scripts/harness/*)",
      "Bash(git:status)",
      "Bash(git:diff)",
      "Bash(git:log)",
      "Bash(git:add:*)",
      "Bash(git:commit:*)",
      "Bash(git:push:*)",
      "Bash(docker:ps)",
      "Bash(docker:logs:*)",
      "Bash(docker compose:*)",
      "Bash(psql:*)",
      "Bash(redis-cli:*)",
      "Bash(curl:*)",
      "Bash(jq:*)",
      "Bash(rg:*)",
      "Read",
      "WebFetch",
      "WebSearch"
    ],
    "ask": [
      "Bash(rm:*)",
      "Bash(git:reset:*)",
      "Bash(git:rebase:*)",
      "Bash(git:push:--force*)",
      "Bash(docker:rm:*)",
      "Bash(docker:rmi:*)",
      "Bash(psql:DROP*)",
      "Bash(redis-cli:FLUSHALL*)"
    ],
    "deny": [],
    "defaultMode": "plan"
  },
  "model": "claude-opus-4-7",
  "env": {
    "LANGUAGE": "ko",
    "LLM_ROUTER_DEFAULT": "local-qwen3-math",
    "PHAIAKES9_ENDPOINT": "http://phaiakes9.local:11434"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/harness/backlog.py\" brief --format hook 2>/dev/null || echo '[빌드하네스] 브리핑 실패 — python3 scripts/harness/backlog.py validate 로 진단하세요'"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/harness/backlog.py\" check-edit"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/harness/backlog.py\" check-stop"
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/fence_guard.py\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo '[채팅 형식] 코드 펜스는 실행용 전용(언어 태그 필수). 해시·식별자=인라인 백틱 · 명령 결과=요약 문장+인용문 · 구조체=필드명: 값 산문.'"
          }
        ]
      }
    ]
  }
}
