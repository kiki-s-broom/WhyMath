{
  "_설명": "S01에서 결과 폴더로 복사해(diag_layers.json) 실제 폴더 구조에 맞게 고친다. 경로 패턴은 저장소 기준이며 '**'는 하위 전체. 파일은 위에서부터 처음 맞는 계층으로 분류된다.",
  "_python_roots_설명": "파이썬 모듈 이름을 셀 기준 폴더. 예: src/eos/core/x.py 를 'eos.core.x'로 import 하면 'src'. 빈 문자열은 저장소 최상위. 앞에 있을수록 우선.",
  "python_roots": ["src", "backend", ""],
  "_layers_설명": "Flutter 앱이 app/lib 에 있으면 app 계층에 'app/lib/**'를 추가한다.",
  "layers": {
    "core": ["eos/core/**"],
    "contracts": ["eos/contracts/**"],
    "adapter_math": ["eos/adapters/math/**"],
    "app": ["eos/apps/**", "apps/**"]
  },
  "_forbidden_설명": "[출발, 도착] = 출발 계층은 도착 계층을 import 하면 안 된다. 코어와 계약 사이 방향은 S01 질문 1의 답(설계 의도)에 맞춰 추가한다.",
  "forbidden": [["core", "adapter_math"], ["core", "app"], ["contracts", "adapter_math"], ["contracts", "app"], ["adapter_math", "app"]],
  "math_only_libs": ["sympy", "latex2sympy2", "antlr4", "texteller", "mpmath"],
  "math_free_layers": ["core", "contracts"],
  "ai_sdks": ["anthropic", "openai", "google.generativeai", "google.genai", "ollama", "litellm", "langchain", "langchain_core", "groq", "mistralai", "cohere"],
  "dart_ai_packages": ["google_generative_ai", "dart_openai", "openai_dart", "anthropic_sdk_dart", "langchain", "firebase_vertexai"],
  "_ai_gateway_설명": "AI 모델 호출이 허용되는 유일한 위치 (FZ-14 AI 호출 규약). 여기 밖의 AI SDK import는 위반으로 보고된다.",
  "ai_gateway": ["eos/core/ai/**"],
  "db_drivers": ["psycopg", "psycopg2", "asyncpg", "sqlalchemy", "sqlite3", "pymongo", "supabase"],
  "db_allowed": ["**/infra/**", "**/repository/**", "**/repositories/**", "**/db/**", "migrations/**", "scripts/**"],
  "test_paths": ["tests/**", "**/tests/**", "**/test_*.py", "**/*_test.py", "**/*_test.dart", "**/integration_test/**"]
