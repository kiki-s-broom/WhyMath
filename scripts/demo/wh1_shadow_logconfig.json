{
  "_note": "WH-1 shadow record capture log-config for uvicorn. MUST stay ASCII-only: uvicorn opens this file with the OS locale encoding (cp949 on Korean Windows), so any non-ASCII byte crashes startup with UnicodeDecodeError (live-verified 2026-07-17). Full rationale lives in docs/architecture/shadow_measurement_runbook.md (WH-1 section). | no handler delay: the record file is created at server startup so Test-Path is a valid pre-traffic capture check (delay:true made it always False - 2026-07-17).",
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {
    "default": {
      "()": "uvicorn.logging.DefaultFormatter",
      "fmt": "%(levelprefix)s %(message)s",
      "use_colors": null
    },
    "access": {
      "()": "uvicorn.logging.AccessFormatter",
      "fmt": "%(levelprefix)s %(client_addr)s - \"%(request_line)s\" %(status_code)s"
    },
    "record_json": {
      "format": "%(message)s"
    }
  },
  "handlers": {
    "default": {
      "formatter": "default",
      "class": "logging.StreamHandler",
      "stream": "ext://sys.stderr"
    },
    "access": {
      "formatter": "access",
      "class": "logging.StreamHandler",
      "stream": "ext://sys.stdout"
    },
    "wh1_record_file": {
      "class": "logging.FileHandler",
      "filename": "wh1_shadow_records.log",
      "encoding": "utf-8",
      "formatter": "record_json"
    },
    "intent_shadow_record_file": {
      "class": "logging.FileHandler",
      "filename": "intent_shadow_records.log",
      "encoding": "utf-8",
      "formatter": "record_json"
    }
  },
  "loggers": {
    "uvicorn": {
      "handlers": [
        "default"
      ],
      "level": "INFO",
      "propagate": false
    },
    "uvicorn.error": {
      "level": "INFO"
    },
    "uvicorn.access": {
      "handlers": [
        "access"
      ],
      "level": "INFO",
      "propagate": false
    },
    "whymath.harness.wh1_shadow.record": {
      "handlers": [
        "wh1_record_file"
      ],
      "level": "INFO",
      "propagate": false
    },
    "whymath.api.intent_shadow.record": {
      "handlers": [
        "intent_shadow_record_file"
      ],
      "level": "INFO",
      "propagate": false
    }
  }
}
