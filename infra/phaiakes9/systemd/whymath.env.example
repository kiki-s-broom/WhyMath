# WhyMath 백엔드 환경 변수 템플릿 — /etc/whymath/whymath.env 로 복사해 값을 채운다.
#
#   sudo install -d -m 700 /etc/whymath
#   sudo cp infra/phaiakes9/systemd/whymath.env.example /etc/whymath/whymath.env
#   sudo chmod 600 /etc/whymath/whymath.env   # ★ 시크릿 포함 — 소유자만 읽기(CLAUDE.md 보안)
#
# 형식: systemd EnvironmentFile(KEY=VALUE·따옴표 불요·# 주석). 모든 키는 WHYMATH_ 접두(config.py
# env_prefix). 아래는 *자주 쓰는* 키만 — 권위 있는 전체 목록·기본값은 config.py(Settings)다.
# 미설정 키는 config.py 기본값을 쓴다(여기 둘 필요 없음).

# ── 필수 시크릿 ──────────────────────────────────────────────────────────────
# JWT 서명 키(미성년 인증·세션). 강한 난수로 교체할 것(하드코딩 금지·여기서만).
WHYMATH_JWT_SECRET_KEY=__CHANGE_ME__

# ── 데이터 연결(로컬 기본값 — Phaiakes9 단일 노드) ─────────────────────────────
WHYMATH_DATABASE_URL=postgresql+asyncpg://whymath@127.0.0.1:5432/whymath
WHYMATH_REDIS_URL=redis://127.0.0.1:6379/0
WHYMATH_OLLAMA_HOST=http://127.0.0.1:11434

# ── 클라우드 LLM(선택 — 미설정이면 로컬 전용·CLAUDE.md 비용 #6) ─────────────────
# 라우터가 클라우드 티어로 승급할 때만 사용. 폐쇄망/로컬 전용이면 비워 둔다.
# WHYMATH_ANTHROPIC_API_KEY=
# ARCH-66 — 2026-09-24~2026-12-31 Anthropic API 사용 중단. 재개 판정 전까지 false 유지
# WHYMATH_ANTHROPIC_API_ENABLED=false
# WHYMATH_OPENAI_API_KEY=

# ── L5 OCR(라이브 검증·OCR_LIVE_VERIFICATION.md) ──────────────────────────────
# 활성화 시 startup 1회 부품 로드(실패해도 /v1/ocr만 503·부팅 fail-fast 안 함).
WHYMATH_OCR_ENABLED=true
WHYMATH_OCR_LANGUAGE=korean
# 수식 인식기: rapid_latex(경량) / texteller(고정밀·[ocr-heavy]) / qwen_vl(L3 라우터 경유).
WHYMATH_OCR_RECOGNIZER_BACKEND=qwen_vl
# 영역 검출기: paddle(Phase A) / mfd(rapid-layout PP·Apache-2.0).
WHYMATH_OCR_DETECTOR=mfd
# 한국어 PP-OCRv4 rec 모델 디렉토리(pull_ocr_models.sh의 WHYMATH_OCR_MODEL_DIR와 동일해야 함).
WHYMATH_OCR_MODEL_DIR=/srv/whymath/models/korean
# 저신뢰 영역 재확인 게이트 임계(0=비활성·기본). 예: 0.6.
# WHYMATH_OCR_MIN_CONFIDENCE=0.0
