# WhyMath deploy env TEMPLATE (OPS-03) -- values are intentionally EMPTY.
#
# ASCII-ONLY FILE. Korean explanations live in the runbook, not here:
#   docs/architecture/deployment_cd_runbook.md
# (Same rule as scripts/backup/backup_whymath_pg.ps1 -- config files read by external
#  tools stay ASCII so a cp949/UTF-8 mismatch can never break a deploy.)
#
# HOW TO USE
#   copy this file to deploy/staging.env and deploy/prod.env, then fill every value.
#   deploy/*.env is already git-ignored (.gitignore "*.env") -- real secrets never
#   enter the repository. NEVER commit a filled copy.
#
#   docker compose --env-file deploy/prod.env -f docker-compose.prod.yml up -d
#
# FAIL-CLOSED
#   every value below is referenced as ${VAR:?...} in docker-compose.prod.yml, except
#   the ones marked OPTIONAL. compose REFUSES to start when a required value is empty
#   and prints which one -- there is no silent default. Do not "fix" that by adding
#   defaults to the compose file.
#
# VALUE GENERATION (run on the deploy host; see runbook section 1 for the full block)
#   passwords (URL-safe hex, they are embedded in DSN URLs):
#     python -c "import secrets;print(secrets.token_hex(24))"
#   AES-256 envelope keys (base64 of 32 random bytes):
#     python -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"

# ---- environment identity (container/volume namespacing) --------------------
# staging | prod  -- decides container names and volume names. Getting this wrong
# points a staging deploy at prod volumes, so it is fail-closed too.
DEPLOY_ENV=
# compose project name; keep it distinct per environment (e.g. whymath-staging).
COMPOSE_PROJECT_NAME=

# ---- image ------------------------------------------------------------------
# IMMUTABLE tag only (git short SHA, e.g. 1a2b3c4). "latest" is forbidden: rollback
# needs to name the exact previous artifact.
WHYMATH_IMAGE_TAG=

# ---- published port ---------------------------------------------------------
# host port for the API. staging and prod must differ to coexist on one host.
APP_PORT=
# bind address. 127.0.0.1 (default when unset) = loopback only, proxy in front.
# Set 0.0.0.0 ONLY when LAN exposure is intended (see runbook section 8).
APP_BIND_ADDR=

# ---- credentials (REQUIRED -- compose refuses to start when empty) ----------
WHYMATH_DB_PASSWORD=
WHYMATH_REDIS_PASSWORD=
WHYMATH_JWT_SECRET_KEY=
# minor-chat at-rest envelope key. Required in production: an empty value falls back
# to PLAINTEXT storage, which violates a CLAUDE.md hard prohibition.
WHYMATH_DIALOGUE_CONTENT_ENCRYPTION_KEY=
# device secret at-rest envelope key. Must DIFFER from the dialogue key.
# Required in production (SEC-28): an empty value makes the app REFUSE TO BOOT in
# prod-like environments. Plaintext device-secret storage is a CLAUDE.md hard
# prohibition, so there is no silent fallback -- dev/CI only.
WHYMATH_DEVICE_SECRET_ENCRYPTION_KEY=

# ---- OPTIONAL (empty is a valid, safe configuration) ------------------------
# empty -> evidence rows are stored as metadata only (no plaintext payload).
WHYMATH_EVIDENCE_PAYLOAD_ENCRYPTION_KEY=
# empty -> cloud LLM dispatch stays unconfigured (local Ollama only).
WHYMATH_ANTHROPIC_API_KEY=
# ARCH-66 — 2026-09-24~2026-12-31 Anthropic API 사용 중단(Kiki 결정). false면 키가 있어도 Anthropic 좌석이 꺼진다.
# 재개는 게이트 G-arch66-anthropic-api-pause-review 판정 후에만 true로 바꾼다.
WHYMATH_ANTHROPIC_API_ENABLED=false
# empty -> Langfuse sink is a permanent no-op (tracing off, app unaffected).
WHYMATH_LANGFUSE_PUBLIC_KEY=
WHYMATH_LANGFUSE_SECRET_KEY=
WHYMATH_LANGFUSE_HOST=
# empty -> defaults to http://host.docker.internal:11434 (Ollama on the host).
WHYMATH_OLLAMA_HOST=
